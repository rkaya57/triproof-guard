generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  pending
  processing
  enriching
  analyzing
  completed
  failed
}

enum AnalysisMode {
  csv_only
  onchain
  hybrid
}

enum EnrichmentStatus {
  pending
  processing
  completed
  failed
  skipped
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum WalletStatus {
  approved
  manual_review
  rejected
}

enum SuggestedAction {
  approve
  manual_review
  reject
}

enum EntityType {
  exchange
  service
  bridge
  contract
  protocol
  unknown
  user
}

enum FeedbackLabel {
  correct_decision
  false_positive
  false_negative
  confirmed_risk
  trusted_user
  needs_more_data
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

enum PaymentStatus {
  pending
  verified
  failed
}

enum SubscriptionPlan {
  FREE
  BUILDER
  COMMUNITY
  API_STARTER
  API_GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum CreditLedgerKind {
  payment_credit
  analysis_debit
  admin_adjustment
}

enum HumanityChallengeLevel {
  BASIC
  STANDARD
  STRICT
}

enum HumanitySessionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum HumanityDecision {
  APPROVED
  MANUAL_REVIEW
  REJECTED
}

enum AirdropTaskType {
  X_FOLLOW
  X_QUOTE
  TELEGRAM_JOIN
  THREAT_REPORT
  HUMANITY_GATE_FEEDBACK
}

enum AirdropSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScamGuardIntelKind {
  DOMAIN
  WALLET
  EVM_ADDRESS
  SOLANA_ADDRESS
  TOKEN
  CONTRACT
}

enum ScamGuardIntelVerdict {
  TRUSTED
  SUSPICIOUS
  KNOWN_BAD
}

enum ScamDnaVerdict {
  UNKNOWN
  SUSPICIOUS
  KNOWN_BAD
}

enum TelegramGuardianAlertLevel {
  CAUTION
  HIGH_RISK
  CRITICAL
}

enum TelegramScanSource {
  PRIVATE_COMMAND
  GROUP_GUARDIAN
}

enum TeamPolicyAction {
  ALLOW
  REVIEW
  BLOCK
}

enum TeamPolicyRuleType {
  DOMAIN_ALLOWLIST
  DOMAIN_BLOCK
  EVM_SPENDER_BLOCK
  UNLIMITED_APPROVAL_BLOCK
  SOLANA_AUTHORITY_CHANGE_BLOCK
}

enum FormalDocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SENT
  ARCHIVED
}

enum FormalDocumentType {
  OFFICIAL_LETTER
  DECISION
  MEMO
  MINUTES
  REPORT
}

enum FormalApprovalRole {
  PARAPH
  CONTROL
  APPROVE
}

enum FormalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FormalRecipientKind {
  ACTION
  INFO
}

model User {
  id                         String                @id @default(cuid())
  name                       String
  email                      String                @unique
  passwordHash               String
  projects                   Project[]
  teamReviews                TeamReview[]
  feedbacks                  FeedbackEvent[]
  webhookEndpoints           WebhookEndpoint[]
  paymentTransactions        PaymentTransaction[]
  creditLedgerEntries        CreditLedger[]
  subscription               Subscription?
  subscriptionUsage          SubscriptionUsage[]
  apiKeys                    ApiKey[]
  ownedTelegramGroups        TelegramGuardianGroup[] @relation("TelegramGroupOwner")
  telegramGroupInvites       TelegramGroupInvite[]
  airdropProfile             AirdropProfile?
  airdropSubmissions         AirdropSubmission[]   @relation("AirdropSubmissionUser")
  reviewedAirdropSubmissions AirdropSubmission[]   @relation("AirdropSubmissionReviewer")
  airdropThreatRewards       AirdropThreatReportReward[] @relation("AirdropThreatReportRewardReporter")
  scamGuardIntelEntries      ScamGuardIntelEntry[]
  reviewedScamGuardFeedback  ScamGuardFeedbackEvent[] @relation("ScamGuardFeedbackReviewer")
  submittedThreatReports     CommunityThreatReport[] @relation("CommunityThreatReportReporter")
  reviewedThreatReports      CommunityThreatReport[] @relation("CommunityThreatReportReviewer")
  teamSecurityPolicies       TeamSecurityPolicy[]
  teamPolicyViolations       TeamPolicyViolation[]
  extensionConnectRequests   ExtensionConnectRequest[]
  formalDocuments            FormalDocument[]           @relation("FormalDocumentAuthor")
  formalDocumentAudits       FormalDocumentAudit[]      @relation("FormalDocumentAuditActor")
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model FormalDocument {
  id              String               @id @default(cuid())
  authorId        String
  author          User                 @relation("FormalDocumentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  documentNumber  String?              @unique
  type            FormalDocumentType   @default(OFFICIAL_LETTER)
  status          FormalDocumentStatus @default(DRAFT)
  unit            String               @default("Tri-Proof Protocol")
  subject         String
  recipient       String
  reference       String?
  body            String               @db.Text
  attachments     Json?
  deadlineAt      DateTime?
  submittedAt     DateTime?
  approvedAt      DateTime?
  sentAt          DateTime?
  archivedAt      DateTime?
  approvals       FormalDocumentApproval[]
  recipients      FormalDocumentRecipient[]
  audits          FormalDocumentAudit[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([authorId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([documentNumber])
}

model FormalDocumentApproval {
  id              String               @id @default(cuid())
  documentId      String
  document        FormalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sequence        Int
  role            FormalApprovalRole
  status          FormalApprovalStatus @default(PENDING)
  approverName    String?
  approverEmail   String
  note            String?              @db.Text
  actedAt         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([documentId, sequence])
  @@index([approverEmail, status, sequence])
}

model FormalDocumentRecipient {
  id              String               @id @default(cuid())
  documentId      String
  document        FormalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind            FormalRecipientKind
  recipientName   String
  recipientEmail  String?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  @@index([recipientEmail, kind])
  @@index([documentId, kind])
}

model FormalDocumentAudit {
  id              String         @id @default(cuid())
  documentId      String
  document        FormalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation("FormalDocumentAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName       String
  event           String
  detail          String?        @db.Text
  createdAt       DateTime       @default(now())

  @@index([documentId, createdAt])
}

model ExtensionConnectRequest {
  id                    String    @id @default(cuid())
  verificationCodeHash  String
  pollTokenHash         String    @unique
  deviceName            String?
  status                String    @default("PENDING")
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  extensionTokenId      String?   @unique
  extensionTokenExpiresAt DateTime?
  revokedAt             DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model TeamSecurityPolicy {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean                  @default(true)
  rules     TeamSecurityPolicyRule[]
  violations TeamPolicyViolation[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([userId, active])
}

model TeamSecurityPolicyRule {
  id        String             @id @default(cuid())
  policyId  String
  policy    TeamSecurityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  type      TeamPolicyRuleType
  value     String?            @db.Text
  action    TeamPolicyAction   @default(BLOCK)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([policyId, active])
  @@index([type, active])
}

model TeamPolicyViolation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyId  String?
  policy    TeamSecurityPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  ruleId    String?
  target    String             @db.Text
  source    String
  chain     String?
  action    TeamPolicyAction
  reason    String             @db.Text
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([policyId, createdAt])
}

model Project {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  campaignType String
  chain        String
  notes        String?
  analyses     Analysis[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model Analysis {
  id                      String             @id @default(cuid())
  projectId               String
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                  AnalysisStatus     @default(pending)
  totalWallets            Int                @default(0)
  approvedCount           Int                @default(0)
  manualReviewCount       Int                @default(0)
  rejectedCount           Int                @default(0)
  averageRiskScore        Float              @default(0)
  suspiciousClustersCount Int                @default(0)
  csvFileName             String?
  analysisMode            AnalysisMode       @default(csv_only)
  enrichmentStatus        EnrichmentStatus?
  enrichmentProvider      String?
  enrichedWalletCount     Int                @default(0)
  failedEnrichmentCount   Int                @default(0)
  cacheHitCount           Int                @default(0)
  usedMockFallback        Boolean            @default(false)
  enrichmentWarnings      Json?
  enrichedAt              DateTime?
  wallets                 WalletAnalysis[]
  clusters                Cluster[]
  enrichments             WalletEnrichment[]
  teamReviews             TeamReview[]
  feedbackEvents          FeedbackEvent[]
  webhookDeliveries       WebhookDelivery[]
  creditLedgerEntries     CreditLedger[]
  graphSummary            WalletGraphSummary?
  graphNodes              WalletGraphNode[]
  graphEdges              WalletGraphEdge[]
  aiBrief                 AnalysisAiBrief?
  createdAt               DateTime           @default(now())
  completedAt             DateTime?

  @@index([projectId])
  @@index([createdAt])
}

model AnalysisAiBrief {
  id                  String   @id @default(cuid())
  analysisId          String   @unique
  analysis            Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  inputHash           String
  provider            String
  model               String?
  executiveSummary    String
  decisionRationale   String
  riskDrivers         Json
  recommendedActions  Json
  limitations         Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([analysisId])
  @@index([updatedAt])
}

model WalletAnalysis {
  id                   String            @id @default(cuid())
  analysisId           String
  analysis             Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  walletAddress        String
  chain                String
  entityLabel          String?
  entityType           EntityType        @default(user)
  entityRiskReason     String?
  riskScore            Int
  riskLevel            RiskLevel
  status               WalletStatus
  recommendedAction    SuggestedAction   @default(approve)
  statusExplanation    String?
  fundingSource        String?
  txCount              Int?
  walletAgeDays        Int?
  totalVolume          Float?
  contractsCount       Int?
  campaignActionsCount Int?
  clusterId            String?
  graphComponentId     String?
  graphRiskScore       Int?
  reasons              Json
  firstSeen            DateTime?
  lastSeen             DateTime?
  nativeBalance        Float?
  tokenCount           Int?
  uniqueCounterparties Int?
  lastActiveDaysAgo    Int?
  isContract           Boolean?
  enrichmentProvider   String?
  enrichmentStatus     EnrichmentStatus?
  teamReviews          TeamReview[]
  feedbackEvents       FeedbackEvent[]
  createdAt            DateTime          @default(now())

  @@unique([analysisId, walletAddress])
  @@index([analysisId])
  @@index([walletAddress])
  @@index([clusterId])
  @@index([graphComponentId])
}

model TeamReview {
  id               String          @id @default(cuid())
  analysisId       String
  analysis         Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  walletAnalysisId String?
  walletAnalysis   WalletAnalysis? @relation(fields: [walletAnalysisId], references: [id], onDelete: SetNull)
  walletAddress    String
  reviewerId       String
  reviewer         User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  previousStatus   WalletStatus
  finalStatus      WalletStatus
  feedbackLabel    FeedbackLabel?
  notes            String?
  source           String          @default("dashboard")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([analysisId, walletAddress])
  @@index([analysisId])
  @@index([walletAddress])
  @@index([reviewerId])
}

model FeedbackEvent {
  id               String          @id @default(cuid())
  analysisId       String
  analysis         Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  walletAnalysisId String?
  walletAnalysis   WalletAnalysis? @relation(fields: [walletAnalysisId], references: [id], onDelete: SetNull)
  walletAddress    String
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            FeedbackLabel
  originalStatus   WalletStatus
  finalStatus      WalletStatus?
  riskScore        Int
  riskLevel        RiskLevel
  reasonsSnapshot  Json?
  notes            String?
  source           String          @default("dashboard")
  createdAt        DateTime        @default(now())

  @@index([analysisId])
  @@index([walletAddress])
  @@index([userId])
  @@index([label])
}

model WebhookEndpoint {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  eventTypes  Json
  isActive    Boolean           @default(true)
  description String?
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isActive])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  analysisId     String?
  analysis       Analysis?             @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  eventType      String
  status         WebhookDeliveryStatus @default(pending)
  statusCode     Int?
  errorMessage   String?
  requestPayload Json
  responseBody   String?
  attemptCount   Int                   @default(0)
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([endpointId])
  @@index([analysisId])
  @@index([status])
  @@index([createdAt])
}

model WalletEnrichment {
  id                   String           @id @default(cuid())
  walletAnalysisId     String?
  analysisId           String
  analysis             Analysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  walletAddress        String
  chain                String
  provider             String
  txCount              Int?
  walletAgeDays        Int?
  firstSeen            DateTime?
  lastSeen             DateTime?
  totalVolume          Float?
  nativeBalance        Float?
  tokenCount           Int?
  contractsCount       Int?
  campaignActionsCount Int?
  uniqueCounterparties Int?
  fundingSource        String?
  isContract           Boolean?
  knownEntityLabel     String?
  knownEntityType      String?
  enrichmentStatus     EnrichmentStatus @default(pending)
  errorMessage         String?
  rawData              Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([analysisId])
  @@index([walletAddress])
  @@index([chain, walletAddress])
}

model Cluster {
  id                      String          @id @default(cuid())
  analysisId              String
  analysis                Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  clusterLabel            String
  walletCount             Int
  averageRiskScore        Float
  sharedFundingSource     String?
  behaviorSimilarityScore Int
  suggestedAction         SuggestedAction
  reasons                 Json
  createdAt               DateTime        @default(now())

  @@unique([analysisId, clusterLabel])
  @@index([analysisId])
}

model WalletGraphSummary {
  id                    String   @id @default(cuid())
  analysisId            String   @unique
  analysis              Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  totalNodes            Int
  totalEdges            Int
  connectedWallets      Int
  externalFunders       Int
  referralLinks         Int
  highRiskComponents    Int
  neutralServiceFunders Int
  largestComponent      Int
  maxComponentRisk      Int
  components            Json
  findings              Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([analysisId])
}

model WalletGraphNode {
  id            String   @id @default(cuid())
  analysisId    String
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  nodeKey       String
  address       String?
  chain         String?
  kind          String
  label         String?
  walletAddress String?
  componentId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([analysisId, nodeKey])
  @@index([analysisId])
  @@index([analysisId, componentId])
  @@index([analysisId, walletAddress])
}

model WalletGraphEdge {
  id            String   @id @default(cuid())
  analysisId    String
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  edgeKey       String
  sourceKey     String
  targetKey     String
  kind          String
  confidence    Int
  isRiskBearing Boolean  @default(false)
  componentId   String?
  observedAt    DateTime?
  transactionId String?
  amount        Float?
  evidence      Json
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([analysisId, edgeKey])
  @@index([analysisId])
  @@index([analysisId, componentId])
  @@index([analysisId, sourceKey])
  @@index([analysisId, targetKey])
  @@index([analysisId, isRiskBearing])
}

model PaymentTransaction {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            String
  network             String
  plan                String
  txHash              String         @unique
  reference           String?
  amountUsdc          Decimal        @db.Decimal(18, 6)
  walletCredits       Int
  confirmations       Int            @default(0)
  status              PaymentStatus  @default(verified)
  rawData             Json?
  creditLedgerEntries CreditLedger[]
  subscription        Subscription?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransactionId String?            @unique
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  startsAt             DateTime           @default(now())
  expiresAt            DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([plan, status, expiresAt])
}

model SubscriptionUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          String
  periodStart     DateTime
  scanCount       Int      @default(0)
  deepScanCount   Int      @default(0)
  analysisWalletCount Int  @default(0)
  apiRequestCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, period, periodStart])
  @@index([userId, periodStart])
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String   @unique
  prefix     String
  lastFour   String
  isActive   Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  @@index([userId, isActive])
}

model TelegramGroupInvite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model CreditLedger {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  analysisId           String?
  analysis             Analysis?           @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  kind                 CreditLedgerKind
  amount               Int
  balanceAfter         Int
  idempotencyKey       String              @unique
  metadata             Json?
  createdAt            DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([analysisId])
  @@index([paymentTransactionId])
}

model HumanityCampaign {
  id                   String                     @id @default(cuid())
  projectId            String?
  name                 String
  slug                 String                     @unique
  description          String?
  humanityGateEnabled  Boolean                    @default(true)
  challengeLevel       HumanityChallengeLevel     @default(STANDARD)
  proofExpiresInDays   Int                        @default(30)
  maxAttemptsPerWallet Int                        @default(3)
  sessions             HumanityChallengeSession[]
  verifications        HumanityVerification[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([projectId])
}

model HumanityChallengeSession {
  id                String                @id @default(cuid())
  campaignId        String
  campaign          HumanityCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  walletAddress     String
  walletChain       String?
  nonce             String                @unique
  challengeSequence Json
  status            HumanitySessionStatus @default(PENDING)
  expiresAt         DateTime
  verification      HumanityVerification?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([campaignId, walletAddress])
  @@index([status])
}

model HumanityVerification {
  id                    String                   @id @default(cuid())
  campaignId            String
  campaign              HumanityCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionId             String                   @unique
  session               HumanityChallengeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  walletAddress         String
  walletChain           String?
  nullifierHash         String                   @unique
  humanSessionScore     Float
  facePresenceScore     Float?
  headPoseScore         Float?
  eyeBlinkScore         Float?
  handGestureScore      Float?
  motionTimingScore     Float?
  frameConsistencyScore Float?
  replayRiskScore       Float?
  injectionRiskScore    Float?
  decision              HumanityDecision
  reasonCodes           Json
  signedMessage         String?
  signature             String?
  signatureVerified     Boolean                  @default(false)
  proofExpiresAt        DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([campaignId, walletAddress])
  @@index([decision])
}

model AirdropProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  xHandle           String?
  rewardWallet      String?
  totalPoints       Int                 @default(0)
  eligibilityStatus String              @default("registered")
  submissions       AirdropSubmission[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([totalPoints])
  @@index([eligibilityStatus])
}

model AirdropTask {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String              @db.Text
  targetUrl     String?             @db.Text
  type          AirdropTaskType
  points        Int
  proofRequired Boolean             @default(true)
  active        Boolean             @default(true)
  sortOrder     Int                 @default(0)
  submissions   AirdropSubmission[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([active, sortOrder])
}

model AirdropSubmission {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation("AirdropSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  profileId          String
  profile            AirdropProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  taskId             String
  task               AirdropTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status             AirdropSubmissionStatus @default(PENDING)
  evidenceUrl        String?
  evidenceImageData  String?                 @db.Text
  feedbackText       String?                 @db.Text
  humanityTestResult Json?
  pointsAwarded      Int                     @default(0)
  adminNotes         String?                 @db.Text
  reviewedById       String?
  reviewedBy         User?                   @relation("AirdropSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([userId, taskId])
  @@index([status, createdAt])
  @@index([profileId])
  @@index([reviewedById])
}

model ScamGuardIntelEntry {
  id          String                @id @default(cuid())
  kind        ScamGuardIntelKind
  value       String
  normalized  String
  chain       String                @default("")
  verdict     ScamGuardIntelVerdict
  label       String
  source      String                @default("admin")
  notes       String?               @db.Text
  active      Boolean               @default(true)
  createdById String?
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([kind, normalized, chain])
  @@index([kind, normalized])
  @@index([verdict, active])
  @@index([createdById])
}

model ScamGuardFeedbackEvent {
  id           String   @id @default(cuid())
  scanId       String?
  verdict      String
  value        String?  @db.Text
  normalized   String?
  chain        String?
  reason       String?  @db.Text
  source       String   @default("public_api")
  status       String   @default("PENDING")
  reviewedById String?
  reviewedBy   User?    @relation("ScamGuardFeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([normalized, createdAt])
  @@index([reviewedById])
}

model CommunityThreatReport {
  id                    String   @id @default(cuid())
  reporterId            String
  reporter              User     @relation("CommunityThreatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  projectName           String
  target                String   @db.Text
  normalizedTarget      String
  targetKind            String
  chain                 String?
  category              String
  description           String   @db.Text
  evidenceUrl           String?  @db.Text
  evidenceNote          String?  @db.Text
  status                String   @default("PENDING")
  reviewerId            String?
  reviewer              User?    @relation("CommunityThreatReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerNote          String?  @db.Text
  promotedIntelEntryId  String?
  airdropReward         AirdropThreatReportReward?
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([reporterId, createdAt])
  @@index([normalizedTarget, status])
  @@index([reviewerId])
}

model AirdropThreatReportReward {
  id         String                @id @default(cuid())
  reportId   String                @unique
  report     CommunityThreatReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                  @relation("AirdropThreatReportRewardReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  rewardDate String
  points     Int
  creditedAt DateTime?
  createdAt  DateTime              @default(now())

  @@unique([reporterId, rewardDate])
  @@index([reporterId, creditedAt])
}

model ScamDnaCampaign {
  id            String               @id @default(cuid())
  clusterKey    String               @unique
  verdict       ScamDnaVerdict       @default(UNKNOWN)
  label         String?
  notes         String?              @db.Text
  sampleCount   Int                  @default(0)
  domainCount   Int                  @default(0)
  strongestRisk String               @default("SAFE")
  domains       Json
  firstSeenAt   DateTime             @default(now())
  lastSeenAt    DateTime             @default(now())
  fingerprints ScamDnaFingerprint[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([verdict, lastSeenAt])
  @@index([strongestRisk, lastSeenAt])
}

model ScamDnaFingerprint {
  id               String           @id @default(cuid())
  fingerprintKey   String           @unique
  campaignId       String?
  campaign         ScamDnaCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  domain           String
  sourceUrl        String           @db.Text
  finalUrl         String?          @db.Text
  contentHash      String
  domHash          String
  scriptHash       String
  textHash         String
  styleHash        String
  faviconUrlHash   String
  redirectHash     String
  behaviorHash     String
  behaviorFlags    Json
  walletTargets    Json
  programTargets   Json
  sandboxSignals   Json
  riskLevel        String
  score            Int
  observationCount Int              @default(1)
  firstSeenAt      DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([campaignId, lastSeenAt])
  @@index([domain, lastSeenAt])
  @@index([domHash])
  @@index([scriptHash])
  @@index([behaviorHash])
  @@index([riskLevel, lastSeenAt])
}

model TelegramGuardianGroup {
  id              String                     @id @default(cuid())
  ownerId         String?
  owner           User?                      @relation("TelegramGroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  telegramChatId  String                     @unique
  title           String?
  username        String?
  guardianEnabled Boolean                    @default(true)
  allowlisted     Boolean                    @default(false)
  alertLevel      TelegramGuardianAlertLevel @default(HIGH_RISK)
  dailySummary    Boolean                    @default(true)
  autoMuteCritical Boolean                   @default(false)
  scanCount       Int                        @default(0)
  alertCount      Int                        @default(0)
  lastSeenAt      DateTime                   @default(now())
  lastSummaryAt   DateTime?
  scans           TelegramScanEvent[]
  threatCampaigns TelegramThreatCampaign[]
  managers        TelegramGuardianAdmin[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([guardianEnabled, allowlisted])
  @@index([ownerId])
  @@index([lastSeenAt])
}

model TelegramGuardianAdmin {
  id             String                 @id @default(cuid())
  groupId        String
  group          TelegramGuardianGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramUserId String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([groupId, telegramUserId])
  @@index([groupId])
}

model TelegramScanEvent {
  id                String                 @id @default(cuid())
  groupId           String?
  group             TelegramGuardianGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramUpdateId  String?
  telegramChatId    String
  telegramMessageId Int
  telegramUserId    String?
  target            String                 @db.Text
  targetHash        String
  domain            String?
  scanType          String
  source            TelegramScanSource
  chain             String
  riskLevel         String
  score             Int
  confidence        String
  summary           String                 @db.Text
  alerted           Boolean                @default(false)
  createdAt         DateTime               @default(now())

  @@unique([telegramChatId, telegramMessageId, targetHash])
  @@index([groupId, createdAt])
  @@index([telegramChatId, createdAt])
  @@index([targetHash, createdAt])
  @@index([riskLevel, alerted, createdAt])
}

model TelegramWatchlist {
  id            String   @id @default(cuid())
  telegramUserId String
  telegramChatId String
  target        String   @db.Text
  targetHash    String
  domain        String?
  chain         String   @default("unknown")
  scanType      String
  active        Boolean  @default(true)
  lastRiskLevel String?
  lastScore     Int?
  lastAlertedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([telegramUserId, targetHash])
  @@index([telegramUserId, active])
  @@index([targetHash, active])
}

model TelegramThreatCampaign {
  id              String                @id @default(cuid())
  groupId         String
  group           TelegramGuardianGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fingerprint     String
  target          String                @db.Text
  domain          String?
  occurrenceCount Int                   @default(1)
  highestRisk     String
  firstSeenAt     DateTime              @default(now())
  lastSeenAt      DateTime              @default(now())
  lastAlertAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([groupId, fingerprint])
  @@index([groupId, lastSeenAt])
  @@index([highestRisk, lastSeenAt])
}
