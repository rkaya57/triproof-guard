enum CampaignLifecycle {
  draft
  active
  paused
  completed
  archived
}

enum CampaignDecisionState {
  allow
  review
  exclude
  insufficient_data
}

model Campaign {
  id                String               @id @default(cuid())
  legacyProjectId   String?              @unique
  ownerUserId       String
  name              String
  campaignType      String
  legacyChain       String?
  networks          String[]             @default([])
  lifecycle         CampaignLifecycle    @default(active)
  notes             String?
  startsAt          DateTime?
  endsAt            DateTime?
  rewardPoolUsd     Decimal?             @db.Decimal(18, 6)
  metadata          Json?
  analysisRuns      CampaignAnalysisRun[]
  policies          CampaignPolicy[]
  decisions         CampaignDecision[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([ownerUserId, lifecycle, updatedAt])
  @@index([campaignType, updatedAt])
}

model CampaignAnalysisRun {
  id                      String                    @id @default(cuid())
  campaignId              String
  campaign                Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  legacyAnalysisId        String?                   @unique
  policyId                String?
  policy                  CampaignPolicy?           @relation(fields: [policyId], references: [id], onDelete: SetNull)
  status                  String
  modelVersion            String
  policyVersion           String?
  inputHash               String?
  campaignSnapshot        Json
  totalWallets            Int                       @default(0)
  approvedCount           Int                       @default(0)
  manualReviewCount       Int                       @default(0)
  rejectedCount           Int                       @default(0)
  averageRiskScore        Float                     @default(0)
  suspiciousClustersCount Int                       @default(0)
  startedAt               DateTime                  @default(now())
  completedAt             DateTime?
  decisions               CampaignDecision[]
  onchainEvents           NormalizedOnchainEvent[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([campaignId, createdAt])
  @@index([status, createdAt])
  @@index([policyId])
}

model CampaignPolicy {
  id          String                @id @default(cuid())
  campaignId  String
  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  version     Int
  preset      String?
  policyHash  String?
  definition  Json
  isActive    Boolean               @default(false)
  analysisRuns CampaignAnalysisRun[]
  decisions   CampaignDecision[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([campaignId, version])
  @@index([campaignId, isActive, updatedAt])
}

model CampaignDecision {
  id             String                @id @default(cuid())
  campaignId     String
  campaign       Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  analysisRunId  String
  analysisRun    CampaignAnalysisRun   @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  policyId       String?
  policy         CampaignPolicy?       @relation(fields: [policyId], references: [id], onDelete: SetNull)
  walletAddress  String
  chain          String
  state          CampaignDecisionState
  riskScore      Int
  confidence     Int?
  clusterId      String?
  evidence       Json
  matchedRules   Json
  explanation    String?               @db.Text
  modelVersion   String
  policyVersion  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([analysisRunId, chain, walletAddress])
  @@index([campaignId, state, createdAt])
  @@index([walletAddress, chain])
  @@index([clusterId])
  @@index([policyId])
}
