# Database
DATABASE_URL="YOUR_POSTGRES_DATABASE_URL"

# Auth
NEXTAUTH_SECRET="YOUR_LONG_RANDOM_SECRET"
ACCESS_PASS_SIGNING_SECRET="YOUR_LONG_RANDOM_ACCESS_PASS_SECRET"
HUMANITY_NULLIFIER_SECRET="YOUR_LONG_RANDOM_HUMANITY_NULLIFIER_SECRET"
NEXTAUTH_URL="http://localhost:3000"
DEV_ALLOW_INSECURE_SECRETS="false"
ADMIN_EMAILS=""

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# On-chain provider API keys
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
ALCHEMY_API_KEY="YOUR_ALCHEMY_API_KEY"
HELIUS_API_KEY="YOUR_HELIUS_API_KEY"
SOLANA_RPC_URL="YOUR_HELIUS_SOLANA_RPC_URL"
SOLANA_RPC_FALLBACK_URLS=""

# Low-cost Solana provider split
# Alchemy is the primary historical provider. A free account has archive access;
# keep getTransactionsForAddress below the account-wide CUPS limit.
ALCHEMY_SOLANA_HISTORY_RPS="5"
ALCHEMY_SOLANA_WALLET_CONCURRENCY="4"
# Helius Free is used only for batched current account-state reads.
HELIUS_PLAN="free"
HELIUS_STATE_RPS="8"
HELIUS_HISTORY_FALLBACK_RPS="2"
# Legacy Helius-only screening remains available when Alchemy is unavailable.
HELIUS_BULK_RPC_RPS="8"
HELIUS_BULK_CONCURRENCY="4"
HELIUS_BULK_MIN_WALLETS="25"
HELIUS_BULK_OLDEST_TX_LIMIT="4"
HELIUS_BULK_NEWEST_TX_LIMIT="8"
HELIUS_BULK_REQUEST_TIMEOUT_MS="30000"

# Solana history depth
# Screening reads a bounded recent window for every wallet. Deep mode follows
# Alchemy pagination up to this ceiling and marks remaining history truncated.
SOLANA_SCREENING_TX_LIMIT="20"
SOLANA_OLDEST_TX_LIMIT="6"
SOLANA_DEEP_HISTORY_LIMIT="1000"
SOLANA_PROVIDER_REQUEST_TIMEOUT_MS="35000"

# Optional fallback provider
BLOCKSCOUT_API_URL="YOUR_BLOCKSCOUT_API_URL"

# ScamGuard URL Sandbox
SCAMGUARD_SANDBOX_ENABLED="true"
SCAMGUARD_SANDBOX_TIMEOUT_MS="7000"
SCAMGUARD_SANDBOX_MAX_BYTES="1048576"
SCAMGUARD_SANDBOX_MAX_REDIRECTS="4"
SCAMGUARD_BOOTSTRAP_KNOWN_BAD_DOMAINS=""

# Backward-compatible per-chain explorer keys
BASESCAN_API_KEY="YOUR_BASESCAN_API_KEY"
ARBISCAN_API_KEY="YOUR_ARBISCAN_API_KEY"
OPTIMISTIC_ETHERSCAN_API_KEY="YOUR_OPTIMISTIC_ETHERSCAN_API_KEY"
POLYGONSCAN_API_KEY="YOUR_POLYGONSCAN_API_KEY"
BSCSCAN_API_KEY="YOUR_BSCSCAN_API_KEY"

# Treasury wallet for Solana USDC and native SOL checkout
TRIPROOF_TREASURY_SOLANA_ADDRESS="YOUR_SOLANA_TREASURY_WALLET"
TRIPROOF_TREASURY_BASE_ADDRESS="YOUR_BASE_TREASURY_WALLET"
TRIPROOF_TREASURY_POLYGON_ADDRESS="YOUR_POLYGON_TREASURY_WALLET"

# USDC token settings
BASE_USDC_CONTRACT="YOUR_BASE_USDC_CONTRACT"
POLYGON_USDC_CONTRACT="YOUR_POLYGON_USDC_CONTRACT"
SOLANA_USDC_MINT="YOUR_SOLANA_USDC_MINT"
PAYMENT_CONFIRMATIONS="1"
COINGECKO_DEMO_API_KEY="YOUR_COINGECKO_DEMO_API_KEY"

# On-chain enrichment runtime config
ONCHAIN_ENRICHMENT_ENABLED="true"
ONCHAIN_PROVIDER_PRIORITY="helius,etherscan,alchemy,blockscout,mock"
ONCHAIN_MAX_WALLETS_PER_ANALYSIS="0"
ONCHAIN_BATCH_SIZE="4"
ONCHAIN_REQUEST_DELAY_MS="500"
ONCHAIN_CACHE_TTL_HOURS="24"
SOLANA_RPC_MAX_CONCURRENCY="3"
SOLANA_RPC_MIN_INTERVAL_MS="125"
SOLANA_RPC_ENDPOINT_COOLDOWN_MS="15000"
SOLANA_TRANSACTION_SAMPLE_LIMIT="12"
SOLANA_SIGNATURE_SAMPLE_LIMIT="250"
ANALYSIS_MAX_BATCH_RETRIES="5"

# High-volume analysis partitioning
ANALYSIS_WALLET_BATCH_SIZE="250"
ANALYSIS_WALLET_BATCH_SIZE_EVM="100"
# Dashboard uploads use resumable screening batches. Deep audits intentionally
# stay small because history pagination is performed per wallet.
SOLANA_SCREENING_BATCH_SIZE="100"
SOLANA_DEEP_HISTORY_BATCH_SIZE="10"
SYBIL_SCALABLE_ENGINE_THRESHOLD="10000"
TRIPROOF_API_MAX_WALLETS="50000"

# Background batch worker
WORKER_SECRET="YOUR_RANDOM_WORKER_SECRET"
ANALYSIS_WORKER_SECRET="YOUR_RANDOM_WORKER_SECRET"
CRON_SECRET="YOUR_RANDOM_WORKER_SECRET"
ANALYSIS_WORKER_ID=""
ANALYSIS_BATCH_LEASE_TIMEOUT_MS="180000"
ANALYSIS_BATCH_HEARTBEAT_MS="120000"
ANALYSIS_BATCH_STALE_MINUTES="3"
WORKER_BOOTSTRAP_MAX_BATCHES="2"
WORKER_BOOTSTRAP_TIME_BUDGET_MS="240000"
WORKER_CONTINUATION_MAX_BATCHES="2"
WORKER_CONTINUATION_TIME_BUDGET_MS="240000"
WORKER_MAX_BATCHES="25"
WORKER_TIME_BUDGET_MS="240000"

# Telegram Bot and Group Guardian
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_WEBHOOK_SECRET="YOUR_LONG_RANDOM_WEBHOOK_SECRET"
TELEGRAM_GROUP_ALERT_LEVEL="HIGH_RISK"
TELEGRAM_GROUP_ALLOWLIST=""

# Optional Gemini AI decision brief
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"
