# Database
DATABASE_URL="YOUR_POSTGRES_DATABASE_URL"

# Auth
NEXTAUTH_SECRET="YOUR_LONG_RANDOM_SECRET"
ACCESS_PASS_SIGNING_SECRET="YOUR_LONG_RANDOM_ACCESS_PASS_SECRET"
HUMANITY_NULLIFIER_SECRET="YOUR_LONG_RANDOM_HUMANITY_NULLIFIER_SECRET"
NEXTAUTH_URL="http://localhost:3000"
# Local development only: set to true if you intentionally want insecure dev fallbacks
DEV_ALLOW_INSECURE_SECRETS="false"

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# On-chain provider API keys
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
ALCHEMY_API_KEY="YOUR_ALCHEMY_API_KEY"
HELIUS_API_KEY="YOUR_HELIUS_API_KEY"
SOLANA_RPC_URL="YOUR_HELIUS_SOLANA_RPC_URL"

# Optional fallback provider
BLOCKSCOUT_API_URL="YOUR_BLOCKSCOUT_API_URL"

# Backward-compatible per-chain explorer keys
BASESCAN_API_KEY="YOUR_BASESCAN_API_KEY"
ARBISCAN_API_KEY="YOUR_ARBISCAN_API_KEY"
OPTIMISTIC_ETHERSCAN_API_KEY="YOUR_OPTIMISTIC_ETHERSCAN_API_KEY"
POLYGONSCAN_API_KEY="YOUR_POLYGONSCAN_API_KEY"
BSCSCAN_API_KEY="YOUR_BSCSCAN_API_KEY"

# Treasury wallets for USDC checkout
TRIPROOF_TREASURY_SOLANA_ADDRESS="YOUR_SOLANA_TREASURY_WALLET"
TRIPROOF_TREASURY_BASE_ADDRESS="YOUR_BASE_TREASURY_WALLET"
TRIPROOF_TREASURY_POLYGON_ADDRESS="YOUR_POLYGON_TREASURY_WALLET"

# USDC token settings
BASE_USDC_CONTRACT="YOUR_BASE_USDC_CONTRACT"
POLYGON_USDC_CONTRACT="YOUR_POLYGON_USDC_CONTRACT"
SOLANA_USDC_MINT="YOUR_SOLANA_USDC_MINT"
PAYMENT_CONFIRMATIONS="1"

# On-chain enrichment runtime config
ONCHAIN_ENRICHMENT_ENABLED="true"
ONCHAIN_PROVIDER_PRIORITY="helius,etherscan,alchemy,blockscout,mock"
ONCHAIN_MAX_WALLETS_PER_ANALYSIS="0"
ONCHAIN_BATCH_SIZE="10"
ONCHAIN_REQUEST_DELAY_MS="500"
ONCHAIN_CACHE_TTL_HOURS="24"

# Background batch worker
WORKER_SECRET="YOUR_RANDOM_WORKER_SECRET"
ANALYSIS_WORKER_SECRET="YOUR_RANDOM_WORKER_SECRET"
CRON_SECRET="YOUR_RANDOM_WORKER_SECRET"
