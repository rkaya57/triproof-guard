# Database
DATABASE_URL="YOUR_POSTGRES_DATABASE_URL"

# Auth
NEXTAUTH_SECRET="YOUR_LONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# On-chain provider API keys
# Recommended MVP setup: Etherscan V2 single key plus optional Alchemy key.
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
ALCHEMY_API_KEY="YOUR_ALCHEMY_API_KEY"

# Optional fallback provider. Example format: https://example-blockscout-instance/api
BLOCKSCOUT_API_URL="YOUR_BLOCKSCOUT_API_URL"

# Backward-compatible per-chain explorer keys. Usually not needed if ETHERSCAN_API_KEY is set.
BASESCAN_API_KEY="YOUR_BASESCAN_API_KEY"
ARBISCAN_API_KEY="YOUR_ARBISCAN_API_KEY"
OPTIMISTIC_ETHERSCAN_API_KEY="YOUR_OPTIMISTIC_ETHERSCAN_API_KEY"
POLYGONSCAN_API_KEY="YOUR_POLYGONSCAN_API_KEY"
BSCSCAN_API_KEY="YOUR_BSCSCAN_API_KEY"

# On-chain enrichment runtime config
ONCHAIN_ENRICHMENT_ENABLED="true"
ONCHAIN_PROVIDER_PRIORITY="etherscan,alchemy,blockscout,mock"
# 0 disables the hard app-level wallet cap. Provider/Vercel limits still apply.
ONCHAIN_MAX_WALLETS_PER_ANALYSIS="0"
ONCHAIN_BATCH_SIZE="10"
ONCHAIN_REQUEST_DELAY_MS="500"
ONCHAIN_CACHE_TTL_HOURS="24"

# Background batch worker. Vercel Cron can use the same value as CRON_SECRET.
ANALYSIS_WORKER_SECRET="YOUR_RANDOM_WORKER_SECRET"
CRON_SECRET="YOUR_RANDOM_WORKER_SECRET"
